@model List<ResultSliderDto>
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Slider İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Slider Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Ana Sayfada Slider ile ilgili işlemleri aşağıdan gerçekleştirebilirsiniz :
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th>@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.Description</td>
                                        <td><a href="/Slider/Delete/@item.Id" class="btn btn-outline-danger">Sil</a></td>
                                        <td><a href="/Slider/Update/@item.Id" class="btn btn-outline-success">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Slider/Create/" class="btn btn-outline-primary">Yeni Slider Girişi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
