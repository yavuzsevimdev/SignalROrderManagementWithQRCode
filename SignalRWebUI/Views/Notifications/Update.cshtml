@model UpdateNotificationDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Bildirim İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Bildirim Güncelleme Sayfası</div>
                        </div>
                        <input type="hidden" asp-for="Id">
                        <div class="card-body">
                            <div class="form-group">
                                <label for="Type">Bildirim türünü giriniz...</label>
                                <input asp-for="Type" type="text" class="form-control" id="Type">
                            </div>
                            <div class="form-group">
                                <label for="Icon">Bildirim ikonunu giriniz...</label>
                                <input asp-for="Icon" type="text" class="form-control" id="Icon">
                            </div>
                            <div class="form-group">
                                <label for="Description">Bildirim açıklamasını giriniz...</label>
                                <input asp-for="Description" type="text" class="form-control" id="Description">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-primary">Bildirimi Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
 