@model UserEditDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Profil Ayarlar</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Şifre ve Bilgi Güncelleme Sayfası</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="Name">Adınız</label>
                                <input asp-for="Name" type="text" class="form-control" id="Name">
                            </div>
                            <div class="form-group">
                                <label for="Surname">Soyadınız</label>
                                <input asp-for="Surname" type="text" class="form-control" id="Surname">
                            </div>
                            <div class="form-group">
                                <label for="Mail">Mail Adresiniz</label>
                                <input asp-for="Mail" type="email" class="form-control" id="Mail">
                            </div>
                            <div class="form-group">
                                <label for="Username">Kullanıcı Adınız</label>
                                <input asp-for="Username" type="text" class="form-control" id="Username">
                            </div>
                            <div class="form-group">
                                <label for="Password">Şifreniz</label>
                                <input asp-for="Password" type="password" class="form-control" id="Password">
                            </div>
                            <div class="form-group">
                                <label for="ConfirmPassword">Şifrenizi Onaylayın</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-success">Bilgileri Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
