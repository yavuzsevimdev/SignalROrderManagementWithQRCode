@{
    Layout = null;
}

<!DOCTYPE html>
<html>
@await Component.InvokeAsync("_UILayoutHeadComponentPartial")
<body class="sub_page">
    @await Component.InvokeAsync("_MenuNavbarComponentPartial")
    <section class="food_section layout_padding">
        <div class="container">

            <div class="container mt-5">
                <div class="row">
                    <div class="col-12">
                        <h3 class="text-center mb-4">SignalR Restoran Anlık Mesajlaşma</h3>
                    </div>
                </div>

                <div class="row p-1">
                    <div class="col-2">
                        Kullanıcı Adınız:
                    </div>
                    <div class="col-5">
                        <input type="text" id="userinput" class="form-control" />
                    </div>
                </div>
                
                <div class="row p-1">
                    <div class="col-2">
                        Mesajınız:
                    </div>
                    <div class="col-5">
                        <input type="text" id="messageinput" class="form-control" />
                    </div>
                </div>

                <div class="row p-1">
                    <div class="col-2"></div>
                    <div class="col-3">
                        <input type="button" id="sendbutton" class="btn btn-warning" value="Mesaj Gönder" />
                    </div>
                </div>

                <div class="row p-1">
                    <div class="col-12">
                        <hr />
                    </div>
                </div>

                <div class="row p-1">
                    <div class="col-12">
                        <ul id="messagelist" class="list-group"></ul>
                    </div>
                </div>
            </div>

        </div>
    </section>
    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")
    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.29/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>
</body>
</html>