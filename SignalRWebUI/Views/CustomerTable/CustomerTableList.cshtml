@model List<ResultMenuTableDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
@await Component.InvokeAsync("_UILayoutHeadComponentPartial")
<style>
    .widget {
        width: 200px;
        height: 100px;
        background-color: #2ecc71; /* Yeşil arka plan */
        display: flex;
        align-items: center;
        border-radius: 10px;
        color: white;
        font-family: Arial, sans-serif;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .widget-icon {
        width: 40px;
        height: 40px;
        background-color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-left: 10px;
    }

        .widget-icon i {
            font-size: 24px;
        }

    .widget-text {
        margin-left: 20px;
    }

        .widget-text h3 {
            margin: 0;
            font-size: 18px;
        }

        .widget-text p {
            margin: 0;
            font-size: 14px;
        }
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<body class="sub_page">
    @await Component.InvokeAsync("_MenuNavbarComponentPartial")

    <br />
    <br />
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-dark mb-30">
                    <a class="breadcrumb-item text-white" href="/Default/Index/">Ana Sayfa</a>
                    <a class="breadcrumb-item text-white" href="/Menu/Index/">Masa Listesi</a>
                    <span class="breadcrumb-item active">Masa Seçimi</span>
                </nav>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row px-xl-5">
            @foreach (var item in Model)
            {
                if (item.Status == false)
                {
                    <a href="/Menu/Index/@item.Id">
                        <div class="widget ml-4 mt-1 mb-1" style="background-color: #2ecc71;">
                            <div class="widget-icon" style="color:#2ecc71;">
                                <i class="fas fa-chair"></i>
                            </div>
                            <div class="widget-text">
                                <h3>@item.Name</h3>
                                <p>Masa Boş</p>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    <a href="/Basket/Index/@item.Id">
                    <div class="widget ml-4 mt-1 mb-1" style="background-color: #FF0000;">
                        <div class="widget-icon" style="color:#FF0000;">
                                <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <div class="widget-text">
                            <h3>@item.Name</h3>
                                <p>Masa Dolu</p>
                        </div>
                    </div>
                    </a>
                }
            }
        </div>
    </div>

    @await Component.InvokeAsync("_UILayoutFooterComponentPartial")
    @await Component.InvokeAsync("_UILayoutScriptComponentPartial")
</body>
</html>