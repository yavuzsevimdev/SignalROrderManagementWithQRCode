@model List<ResultContactDto>

<footer class="footer_section">
    <div class="container">
        @foreach (var item in Model)
        {
            <div class="row">
                <div class="col-md-4 footer-col">
                    <div class="footer_contact">
                        <h4>
                            Bize Ulaşın
                        </h4>
                        <div class="contact_link_box">
                            <a href="@item.Location">
                                <i class="fa fa-map-marker" aria-hidden="true"></i>
                                <span>
                                    Lokasyon
                                </span>
                            </a>
                            <a href="">
                                <i class="fa fa-phone" aria-hidden="true"></i>
                                <span>
                                    Ara @item.Phone
                                </span>
                            </a>
                            <a href="">
                                <i class="fa fa-envelope" aria-hidden="true"></i>
                                <span>
                                    @item.Mail
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 footer-col">
                    <div class="footer_detail">
                        <a href="/Default/Index" class="footer-logo">
                            @item.FooterTitle
                        </a>
                        <p>
                            @item.FooterDescription
                        </p>
                        @await Component.InvokeAsync("_UILayoutSocialMediaComponentPartial")
                    </div>
                </div>
                <div class="col-md-4 footer-col">
                    <h4>
                        @item.OpenDays
                    </h4>
                    <p>
                        @item.OpenDaysDescription
                    </p>
                    <p>
                        @item.OpenHours
                    </p>
                </div>
            </div>

        }
        <div class="footer-info">
            <p>
                &copy; <span id="displayYear"></span> Tüm hakları saklıdır | Bu şablon, <a href="https://html.design/">HTML Tasarım</a> tarafından dağıtılmaktadır<br><br>
                &copy; <span id="displayYear"></span> Geliştiren
                <a href="https://themewagon.com/" target="_blank">YBS Soft</a>
            </p>
        </div>
    </div>
</footer>
