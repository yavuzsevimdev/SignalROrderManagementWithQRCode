@model UpdateTestimonialDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referans Yorum İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Referans Yorumu Güncelleme Sayfası</div>
                        </div>
                        <input type="hidden" asp-for="Id" />
                        <div class="card-body">
                            <div class="form-group">
                                <label for="Name">Müşteri adını giriniz...</label>
                                <input asp-for="Name" type="text" class="form-control" id="Name">
                            </div>
                            <div class="form-group">
                                <label for="Title">Müşteri ünvanını giriniz...</label>
                                <input asp-for="Title" type="text" class="form-control" id="Title">
                            </div>
                            <div class="form-group">
                                <label for="ImageUrl">Müşteri resim dosya yolunu giriniz...</label>
                                <input asp-for="ImageUrl" type="text" class="form-control" id="ImageUrl">
                            </div>
                            <div class="form-group">
                                <label for="Comment">Müşteri yorumunu giriniz...</label>
                                <input asp-for="Comment" type="text" class="form-control" id="Comment">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-primary">Referans Yorumu Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
