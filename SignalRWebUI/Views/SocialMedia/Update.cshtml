@model UpdateSocialMediaDto
@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Sosyal Medya İşlemleri</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div class="card">
                        <input type="hidden" asp-for="Id" />
                        <div class="card-header">
                            <div class="card-title">Sosyal Medya Hesabını Güncelleme Sayfası</div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="Title">Başlığı giriniz...</label>
                                <input asp-for="Title" type="text" class="form-control" id="Title">
                            </div>
                            <div class="form-group">
                                <label for="Icon">İkon giriniz...</label>
                                <input asp-for="Icon" type="text" class="form-control" id="Icon">
                            </div>
                            <div class="form-group">
                                <label for="Url">Link giriniz...</label>
                                <input asp-for="Url" type="text" class="form-control" id="Url">
                            </div>
                        </div>
                        <div class="card-action">
                            <button class="btn btn-primary">Sosyal Medya Hesabını Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
